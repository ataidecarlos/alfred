# Build context exclusions
target
.git
.gitignore

# Local runtime data / secrets
.env
.env.local
local_vars.txt
test_api_keys.toml
config/config.toml
prompts/system.md
prompts/user.md
data
logs

# Tests and tooling. `.github` is deliberately NOT ignored: the runtime images
# read PI_VERSION from .github/workflows/release.yml so the image and the
# release pipeline share a single Pi pin (see Dockerfile).
tests
*.md

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode
.idea
