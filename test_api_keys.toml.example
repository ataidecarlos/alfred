# OpenCode Go API Key for Alfred Testing
# Get your key at: https://opencode.ai/zen/settings/api-keys
# Subscribe to Go ($10/month) for access to these models
#
# Models sorted by cost (cheapest first = most requests per 5h window).
# The application will try each model in order and fall through to the next on failure.
#
# Usage:
#   1. Copy this file to test_api_keys.toml
#   2. Add your API key to test_api_keys.toml
#   3. The .toml file is gitignored and will never be committed

[opencode_go]
api_key = ""
base_url = "https://opencode.ai/zen/go/v1"

# Model preference order (cheapest first, exhaust before moving to next).
# Prices are USD per 1M tokens (input/output) from the OpenCode Go catalog.
#  1. space-bunny-free            - 0 / 0          (free)
#  2. muse-spark-1.3-contributor  - 0.10 / 0.20
#  3. gpt-6-luna                  - 0.10 / 0.50
#  4. mimo-v2.5                   - 0.14 / 0.28
#  5. qwen3.8-flash               - 0.15 / 0.47
#  6. glm-5.3-flash               - 0.15 / 0.50
#  7. deepseek-v4.1-flash         - 0.15 / 0.60
#  8. longcat-2.0                 - 0.30 / 1.20
#  9. minimax-m3                  - 0.30 / 1.20
# 10. minimax-m2.7               - 0.30 / 1.20
# 11. qwen3.7-plus               - 0.40 / 1.60
# 12. mimo-v2.5-pro              - 0.435 / 0.87
# 13. mimo-v2.6-pro              - 0.435 / 0.87
# 14. qwen3.6-plus               - 0.50 / 3.00
# 15. deepseek-v4-pro            - 0.66 / 1.98
# 16. hy4-preview                - 0.834 / 2.501
# 17. kimi-k2.7-code             - 0.95 / 4.00
# 18. glm-5.3                    - 1.40 / 4.40
# 19. grok-4.7                   - 2.00 / 6.00
# 20. qwen3.8-max                - 2.00 / 6.00
# 21. qwen3.7-max                - 2.50 / 7.50
# 22. kimi-k3                    - 3.00 / 15.00

[opencode_go.models]
preference_order = [
    "space-bunny-free",
    "muse-spark-1.3-contributor",
    "gpt-6-luna",
    "mimo-v2.5",
    "qwen3.8-flash",
    "glm-5.3-flash",
    "deepseek-v4.1-flash",
    "longcat-2.0",
    "minimax-m3",
    "minimax-m2.7",
    "qwen3.7-plus",
    "mimo-v2.5-pro",
    "mimo-v2.6-pro",
    "qwen3.6-plus",
    "deepseek-v4-pro",
    "hy4-preview",
    "kimi-k2.7-code",
    "glm-5.3",
    "grok-4.7",
    "qwen3.8-max",
    "qwen3.7-max",
    "kimi-k3"
]
