[server]
port = 8080
host = "0.0.0.0"

[llm]
default_provider = "openai"

[llm.providers.openai]
api_key = "${OPENAI_API_KEY}"
model = "gpt-4o"

[llm.providers.anthropic]
api_key = "${ANTHROPIC_API_KEY}"
model = "claude-sonnet-4-20250514"

[llm.providers.google]
api_key = "${GOOGLE_API_KEY}"
model = "gemini-2.0-flash"

[llm.providers.deepseek]
api_key = "${DEEPSEEK_API_KEY}"
model = "deepseek-v4-flash"
base_url = "https://api.deepseek.com"

# [telegram]
# bot_token = "${TELEGRAM_BOT_TOKEN}"
# allowed_users = []

[prompt]
system_prompt_file = "prompts/system.md"
user_prompt_file = "prompts/user.md"

[scheduler]
enabled = true

[memory]
enabled = true
vault_path = "~/alfred"
mode = "auto"
cli_check_interval_secs = 300
retrieval_review_threshold_days = 90
distillation_interval_secs = 7200
cloud_provider = "openai"
cloud_model = "gpt-4o-mini"
cloud_monthly_limit = 5.0
local_preprocessing = false
local_backend = "auto"
local_model = "phi-4-mini-instruct"
full_local = false
local_llm_provider = "ollama"
local_llm_base_url = "http://localhost:11434/v1"
local_llm_model = "qwen3:8b"
