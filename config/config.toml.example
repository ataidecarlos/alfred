[server]
port = 8080
host = "127.0.0.1"
# api_key = "${ALFRED_API_KEY}"

# [telegram]
# bot_token = "${TELEGRAM_BOT_TOKEN}"
# allowed_users = []

[prompt]
system_prompt_file = "prompts/system.md"
user_prompt_file = "prompts/user.md"

[pi]
# The Pi binary Alfred runs as a subprocess.
binary = "pi"
# Environment variable that holds the provider API key. The key is passed to
# the subprocess by environment, never by --api-key.
api_key_env = "PI_API_KEY"
provider = "opencode-go"
model = "space-bunny-free"
thinking = "off"
jobs_tools = []
channel_tools = []
timeout_secs = 900
idle_compact_secs = 300
compact_token_threshold = 100000
session_dir = "~/.alfred/pi/sessions"
extra_args = []

[jobs]
enabled = true
max_concurrent = 2
min_watch_interval_secs = 900
max_runs_per_job = 100
missing_verdict = "notify"
